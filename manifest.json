<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0C447C">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="HuGo">
<meta name="mobile-web-app-capable" content="yes">
<title>HuGo v10 — Human Rights on the Go</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
:root{
  --navy:#0C447C;--blue:#185FA5;--lb:#E6F1FB;--mb:#B5D4F4;--db:#7FB3E0;--dn:#042C53;
  --green:#3B6D11;--lg:#EAF3DE;--gb:#C0DD97;
  --amber:#633806;--la:#FAEEDA;--ab:#FAC775;
  --red:#791F1F;--lr:#FCEBEB;--rb:#F09595;--dr:#501313;
  --crim:#A32D2D;--cd:#E24B4A;
  --safe-t:env(safe-area-inset-top,0px);--safe-b:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',sans-serif;background:#f0f4f8;}

/* SPLASH */
#splash{position:fixed;inset:0;background:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .5s;}
#splash.hidden{opacity:0;pointer-events:none;}
.sp-logo{width:88px;height:88px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:20px;box-shadow:0 8px 32px rgba(0,0,0,.3);animation:popIn .6s ease;}
@keyframes popIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
.sp-logo .lm{font-size:24px;font-weight:700;color:var(--navy);}
.sp-logo .ls{font-size:10px;color:var(--blue);}
.sp-title{font-size:20px;font-weight:500;color:#fff;margin-bottom:6px;}
.sp-sub{font-size:12px;color:var(--mb);text-align:center;max-width:280px;line-height:1.5;}
.sp-dots{display:flex;gap:8px;margin-top:28px;}
.sp-dot{width:8px;height:8px;border-radius:50%;background:var(--mb);animation:sdot 1.2s infinite;}
.sp-dot:nth-child(2){animation-delay:.2s}.sp-dot:nth-child(3){animation-delay:.4s}
@keyframes sdot{0%,80%,100%{opacity:.3;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}

/* APP SHELL */
#app{display:flex;flex-direction:column;height:100%;padding-top:var(--safe-t);}
#hdr{background:var(--navy);padding:10px 14px;display:flex;align-items:center;gap:10px;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,.2);}
.hdr-logo{width:36px;height:36px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;line-height:1;}
.hdr-logo .lm{font-size:10.5px;font-weight:700;color:var(--navy);}
.hdr-logo .ls{font-size:7px;color:var(--blue);}
.hdr-text{flex:1;min-width:0;}
.hdr-text h1{font-size:13px;font-weight:500;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.hdr-text .hs{font-size:9px;color:var(--mb);margin-top:1px;}
.live-pill{padding:3px 8px;border-radius:10px;font-size:9px;font-weight:500;background:rgba(163,45,45,.7);border:.5px solid var(--cd);color:#fff;display:none;align-items:center;gap:3px;animation:lpulse 1.5s infinite;}
@keyframes lpulse{0%,100%{opacity:1}50%{opacity:.5}}
.live-dot{width:5px;height:5px;border-radius:50%;background:#fff;}
#offline-bar{background:var(--crim);color:#fff;font-size:11px;font-weight:500;padding:6px 14px;text-align:center;display:none;flex-shrink:0;}

/* LOGIN */
#login-screen{flex:1;overflow-y:auto;padding:20px 16px;display:flex;flex-direction:column;gap:14px;background:#f0f4f8;}
.ls-title{font-size:18px;font-weight:700;color:#1a2332;}
.ls-sub{font-size:12px;color:#7a8a9a;line-height:1.5;}
.role-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.role-card{padding:15px 14px;border:.5px solid #d0dce8;border-radius:16px;cursor:pointer;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.06);transition:all .15s;display:flex;flex-direction:column;}
.role-card:active{transform:scale(.97);}
.role-card.sup-card{border-color:var(--gb);}
.rc-ico{font-size:26px;color:var(--blue);margin-bottom:7px;}
.sup-card .rc-ico{color:var(--green);}
.rc-name{font-size:13px;font-weight:600;color:#1a2332;}
.rc-info{font-size:10.5px;color:#7a8a9a;margin-top:3px;line-height:1.4;}

/* AUTH */
#station-auth,#super-auth{flex:1;overflow-y:auto;padding:20px 16px;display:none;flex-direction:column;gap:14px;background:#f0f4f8;}
.auth-header{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.auth-back{width:34px;height:34px;border:.5px solid #d0dce8;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;}
.auth-card{background:#fff;border:.5px solid #d0dce8;border-radius:16px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);}
.auth-card-title{font-size:13px;font-weight:600;color:#1a2332;margin-bottom:12px;display:flex;align-items:center;gap:7px;}
.auth-card-title i{font-size:16px;color:var(--blue);}
.fl{font-size:11px;font-weight:600;color:#5a6a7a;margin-bottom:4px;}
.req{color:var(--crim);}
.fs,.fi{width:100%;padding:11px 13px;font-size:14px;font-family:inherit;border:1px solid #d0dce8;border-radius:12px;outline:none;background:#f8fafc;color:#1a2332;-webkit-appearance:none;}
.fs:focus,.fi:focus{border-color:var(--blue);background:#fff;}
.fg{display:flex;flex-direction:column;gap:4px;margin-bottom:10px;}
.tok-inp{width:100%;padding:12px 14px;font-size:16px;font-family:monospace;border:1px solid #d0dce8;border-radius:12px;outline:none;background:#f8fafc;color:#1a2332;letter-spacing:2px;-webkit-appearance:none;}
.tok-inp:focus{border-color:var(--blue);background:#fff;}

/* ALERTS */
.alert{border-radius:12px;padding:10px 12px;font-size:12px;display:flex;align-items:flex-start;gap:8px;line-height:1.5;}
.alert i{font-size:16px;flex-shrink:0;margin-top:1px;}
.alert.ok{background:var(--lg);border:1px solid var(--gb);color:var(--green);}
.alert.err{background:var(--lr);border:1px solid var(--rb);color:var(--red);}
.alert.warn{background:var(--la);border:1px solid var(--ab);color:var(--amber);}
.alert.urgent{background:#F7C1C1;border:1px solid var(--cd);color:var(--dr);font-weight:600;}
.alert.info{background:var(--lb);border:1px solid var(--mb);color:var(--navy);}

/* BUTTONS */
.pbtn{padding:13px 18px;background:var(--navy);color:#fff;border:none;border-radius:14px;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;width:100%;font-family:inherit;transition:all .15s;}
.pbtn:active{transform:scale(.98);background:var(--blue);}
.pbtn:disabled{background:#c0cdd8;color:#8a9aaa;cursor:not-allowed;}
.sbtn{padding:13px 18px;background:var(--green);color:#fff;border:none;border-radius:14px;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;width:100%;font-family:inherit;}
.sbtn:active{transform:scale(.98);}
.dbtn{padding:13px 18px;background:var(--crim);color:#fff;border:none;border-radius:14px;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;width:100%;font-family:inherit;}
.dbtn:active{transform:scale(.98);}
.gbtn{padding:10px 16px;border:1px solid #d0dce8;background:#fff;border-radius:12px;font-size:13px;cursor:pointer;color:#5a6a7a;display:flex;align-items:center;gap:6px;font-family:inherit;}
.gbtn:active{background:#f0f4f8;}
.add-btn{padding:10px 16px;border:2px dashed #c0cdd8;background:#f8fafc;border-radius:12px;font-size:13px;cursor:pointer;color:var(--blue);display:flex;align-items:center;justify-content:center;gap:6px;width:100%;font-family:inherit;}

/* USER BAR */
#user-bar{padding:6px 14px;background:#f8fafc;border-bottom:.5px solid #d0dce8;display:flex;align-items:center;gap:8px;font-size:11px;flex-shrink:0;}
.ub-pill{padding:2px 8px;border-radius:8px;font-size:9.5px;font-weight:600;}
.ub-st{background:var(--lb);color:var(--navy);}
.ub-su{background:var(--lg);color:var(--green);}
.ub-name{color:#1a2332;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.flag-ind{padding:2px 7px;border-radius:7px;font-size:9.5px;font-weight:600;background:var(--lr);color:var(--red);display:none;align-items:center;gap:3px;}
.sw-btn{font-size:10px;color:var(--blue);cursor:pointer;border:none;background:none;padding:0;white-space:nowrap;}

/* BOTTOM NAV */
#bottom-nav{display:flex;background:#fff;border-top:.5px solid #d0dce8;flex-shrink:0;padding-bottom:var(--safe-b);box-shadow:0 -2px 12px rgba(0,0,0,.08);}
.bnav{flex:1;padding:8px 4px 6px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;border:none;background:none;position:relative;}
.bnav i{font-size:20px;color:#94a3b8;transition:color .15s;}
.bnav span{font-size:9px;color:#94a3b8;transition:color .15s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;}
.bnav.active i{color:var(--navy);}
.bnav.active span{color:var(--navy);font-weight:600;}
.bnav::after{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:0;height:2px;background:var(--navy);border-radius:0 0 3px 3px;transition:width .2s;}
.bnav.active::after{width:32px;}
.nb-badge{position:absolute;top:5px;right:16%;min-width:14px;height:14px;border-radius:7px;background:var(--cd);border:1.5px solid #fff;display:none;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff;padding:0 3px;}
.nb-badge.show{display:flex;}

/* CONTENT */
#content{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;background:#f0f4f8;}
.view{display:none;padding:14px;flex-direction:column;gap:12px;min-height:100%;}
.view.active{display:flex;}

/* CARDS */
.card{background:#fff;border:.5px solid #d0dce8;border-radius:16px;padding:14px 15px;box-shadow:0 2px 8px rgba(0,0,0,.05);}
.card-title{font-size:13px;font-weight:600;color:#1a2332;margin-bottom:12px;display:flex;align-items:center;gap:7px;}
.card-title i{font-size:16px;color:var(--blue);}

/* HOME */
.greeting{font-size:20px;font-weight:700;color:#1a2332;}
.greeting-sub{font-size:12px;color:#7a8a9a;margin-top:2px;}
.stat-row{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.stat-card{background:#fff;border-radius:14px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.06);border:.5px solid #d0dce8;}
.sv{font-size:26px;font-weight:700;color:#1a2332;}
.sv.s{color:var(--green)}.sv.d{color:var(--crim);}
.sl2{font-size:10.5px;color:#7a8a9a;margin-top:2px;}
.sec-lbl{font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.6px;}
.mod-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.mod-card{background:#fff;border:.5px solid #d0dce8;border-radius:14px;padding:13px 12px 11px;cursor:pointer;display:flex;flex-direction:column;gap:5px;box-shadow:0 2px 8px rgba(0,0,0,.05);transition:all .15s;}
.mod-card:active{transform:scale(.97);border-color:var(--blue);}
.mc-ico{font-size:24px;color:var(--blue);}
.mc-name{font-size:12px;font-weight:600;color:#1a2332;line-height:1.3;}
.mc-desc{font-size:10px;color:#7a8a9a;line-height:1.4;}
.mc-badge{margin-top:4px;font-size:9.5px;padding:2px 8px;border-radius:8px;width:fit-content;font-weight:500;}
.mb-g{background:var(--lg);color:var(--green);}
.mb-b{background:var(--lb);color:var(--navy);}
.act-list{display:flex;flex-direction:column;gap:6px;}
.act-row{display:flex;align-items:center;gap:9px;padding:10px 12px;background:#fff;border:.5px solid #d0dce8;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.04);}
.act-ico{font-size:16px;color:var(--blue);flex-shrink:0;}
.act-ico.flag{color:var(--crim);}
.act-body{flex:1;min-width:0;font-size:11.5px;color:#5a6a7a;}
.act-body strong{color:#1a2332;display:block;font-size:12px;}
.act-ts{font-size:9px;color:#94a3b8;white-space:nowrap;}

/* FORM ELEMENTS */
.rw2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.rw3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
.num-wrap{display:flex;align-items:center;gap:10px;}
.num-btn{width:36px;height:36px;border:1px solid #d0dce8;border-radius:10px;background:#f8fafc;cursor:pointer;font-size:20px;color:#1a2332;display:flex;align-items:center;justify-content:center;font-family:inherit;}
.num-btn:active{background:var(--lb);}
.num-disp{font-size:26px;font-weight:700;color:#1a2332;min-width:44px;text-align:center;}
.num-man{width:80px;padding:8px 10px;font-size:14px;font-family:inherit;border:1px solid #d0dce8;border-radius:10px;outline:none;background:#f8fafc;color:#1a2332;text-align:center;}
.month-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;}
.month-opt{padding:7px 4px;border:1px solid #d0dce8;border-radius:10px;font-size:11px;cursor:pointer;color:#5a6a7a;background:#f8fafc;text-align:center;font-family:inherit;}
.month-opt.on{border-color:var(--blue);color:var(--blue);background:var(--lb);font-weight:600;}
.tog-wrap{display:flex;gap:8px;}
.tog{flex:1;padding:10px 14px;border:1px solid #d0dce8;border-radius:12px;font-size:13px;cursor:pointer;background:#f8fafc;color:#5a6a7a;font-weight:500;font-family:inherit;text-align:center;}
.tog.y-on{border-color:var(--green);background:var(--lg);color:var(--green);font-weight:600;}
.tog.n-on{border-color:var(--blue);background:var(--lb);color:var(--blue);font-weight:600;}
.chip-wrap{display:flex;flex-wrap:wrap;gap:5px;margin-top:4px;}
.chip{padding:4px 11px;border:1px solid #d0dce8;border-radius:20px;font-size:11.5px;cursor:pointer;color:#5a6a7a;background:#f8fafc;}
.chip.on{border-color:var(--navy);background:var(--lb);color:var(--navy);font-weight:500;}
.drop-zone{border:2px dashed #c0cdd8;border-radius:14px;padding:20px 14px;text-align:center;cursor:pointer;background:#f8fafc;transition:all .15s;}
.drop-zone.over{border-color:var(--blue);background:var(--lb);}
.drop-zone i{font-size:28px;color:#94a3b8;display:block;margin-bottom:6px;}
.drop-zone p{font-size:12px;color:#7a8a9a;}
.drop-zone small{font-size:10px;color:#94a3b8;}
.file-prev{display:flex;align-items:center;gap:9px;padding:10px 12px;border:1px solid var(--gb);border-radius:12px;background:var(--lg);margin-top:7px;}
.file-prev i{font-size:18px;color:var(--green);}
.fp-n{font-size:12px;font-weight:500;color:var(--green);flex:1;word-break:break-all;}
.fp-r{cursor:pointer;color:var(--crim);font-size:11px;border:none;background:none;padding:0;font-family:inherit;}

/* PROCESSING */
.processing{padding:24px;text-align:center;display:none;}
.proc-dots{display:flex;justify-content:center;gap:6px;}
.proc-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);animation:pd 1.2s infinite;}
.proc-dot:nth-child(2){animation-delay:.2s}.proc-dot:nth-child(3){animation-delay:.4s}
@keyframes pd{0%,80%,100%{transform:translateY(0);opacity:.5}40%{transform:translateY(-6px);opacity:1}}

/* SUCCESS */
.success-card{background:#fff;border-radius:16px;padding:20px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.06);}
.sico{font-size:48px;color:var(--green);display:block;margin-bottom:10px;}
.s-title{font-size:17px;font-weight:700;color:#1a2332;margin-bottom:6px;}
.s-sub{font-size:12px;color:#7a8a9a;line-height:1.5;margin-bottom:14px;}
.json-box{background:var(--dn);border-radius:12px;padding:12px;font-size:10px;font-family:monospace;color:var(--mb);white-space:pre-wrap;word-break:break-all;max-height:140px;overflow-y:auto;text-align:left;margin-bottom:12px;}
.copy-btn{display:flex;align-items:center;justify-content:center;gap:5px;padding:10px 16px;border:1px solid #d0dce8;border-radius:12px;background:#f8fafc;cursor:pointer;color:#5a6a7a;font-size:13px;font-family:inherit;width:100%;}

/* NOTIFICATION */
.notif-card{background:#fff;border:.5px solid #d0dce8;border-radius:14px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.05);}
.notif-title{font-size:12px;font-weight:600;color:#1a2332;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.notif-title i{font-size:14px;color:var(--blue);}
.notif-bar-wrap{height:8px;border-radius:4px;background:#e0e8f0;overflow:hidden;margin-bottom:6px;}
.notif-bar{height:100%;border-radius:4px;background:var(--blue);transition:width .5s;}
.notif-bar.full{background:var(--green);}.notif-bar.low{background:var(--crim);}
.notif-nums{display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;}
.stn-pill{display:inline-block;padding:2px 8px;border-radius:8px;font-size:9.5px;font-weight:600;margin:2px;}
.sp-b{background:var(--lb);color:var(--navy);}
.sp-g{background:var(--lg);color:var(--green);}
.sp-a{background:var(--la);color:var(--amber);}
.sp-r{background:var(--lr);color:var(--red);}

/* ══════════════════════════════════════════
   CAMERA & AI INSPECTION MODULE v7
   ══════════════════════════════════════════ */

/* Camera viewport */
#cam-vp{background:var(--dn);border-radius:16px;overflow:hidden;height:220px;display:flex;align-items:center;justify-content:center;position:relative;border:1px solid var(--blue);}
#cam-video{width:100%;height:100%;object-fit:cover;display:none;}
#cam-ph{text-align:center;color:var(--db);padding:24px;}
#cam-ph i{font-size:40px;display:block;margin-bottom:8px;color:#378ADD;}
#cam-ph p{font-size:13px;}
#cam-sid{position:absolute;top:8px;left:50%;transform:translateX(-50%);font-size:9px;font-family:monospace;color:#378ADD;background:rgba(4,44,83,.85);padding:3px 8px;border-radius:8px;white-space:nowrap;}
#cam-live-ind{position:absolute;top:8px;right:10px;display:none;align-items:center;gap:4px;font-size:10px;color:var(--cd);font-weight:700;background:rgba(4,44,83,.85);padding:3px 8px;border-radius:8px;}
#cam-live-ind .ld{width:6px;height:6px;border-radius:50%;background:var(--cd);animation:lpulse 1s infinite;}

/* AI detection scanner overlay */
#scan-overlay{position:absolute;inset:0;pointer-events:none;}
.scan-line{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(56,200,255,.8),transparent);animation:scanMove 2s linear infinite;}
@keyframes scanMove{0%{top:0;opacity:1}100%{top:100%;opacity:0}}
.scan-corner{position:absolute;width:20px;height:20px;border-color:rgba(56,200,255,.7);border-style:solid;}
.sc-tl{top:8px;left:8px;border-width:2px 0 0 2px;}
.sc-tr{top:8px;right:8px;border-width:2px 2px 0 0;}
.sc-bl{bottom:8px;left:8px;border-width:0 0 2px 2px;}
.sc-br{bottom:8px;right:8px;border-width:0 2px 2px 0;}

/* Detection flash overlay */
#detect-flash{position:absolute;inset:0;border-radius:16px;pointer-events:none;opacity:0;transition:opacity .15s;}
#detect-flash.passed{background:rgba(59,109,17,.3);}
#detect-flash.failed{background:rgba(163,45,45,.3);}
#detect-flash.active{opacity:1;}

/* AI status bar inside viewport */
#ai-status-bar{position:absolute;bottom:0;left:0;right:0;background:rgba(4,44,83,.85);padding:6px 10px;display:none;align-items:center;gap:6px;font-size:10.5px;color:#fff;}
#ai-status-ico{font-size:14px;}
#ai-status-txt{flex:1;}
#ai-conf-bar{height:4px;border-radius:2px;background:rgba(255,255,255,.2);overflow:hidden;width:60px;flex-shrink:0;}
#ai-conf-fill{height:100%;border-radius:2px;background:#fff;transition:width .3s;}

/* Screenshot flash */
#cap-flash{position:absolute;inset:0;background:#fff;border-radius:16px;opacity:0;pointer-events:none;transition:opacity .1s;}
#cap-flash.snap{opacity:.8;}

/* Capture thumbnail strip */
#cap-strip{display:flex;gap:6px;overflow-x:auto;padding:2px 0;-webkit-overflow-scrolling:touch;}
.cap-thumb{flex-shrink:0;width:64px;height:48px;border-radius:8px;overflow:hidden;position:relative;border:2px solid transparent;}
.cap-thumb.passed{border-color:var(--green);}
.cap-thumb.failed{border-color:var(--cd);}
.cap-thumb.unverified{border-color:var(--amber);}
.cap-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
.cap-thumb canvas{width:100%;height:100%;display:block;}
.cap-thumb-label{position:absolute;bottom:0;left:0;right:0;font-size:7px;font-weight:700;text-align:center;padding:2px;color:#fff;}
.cap-thumb.passed .cap-thumb-label{background:rgba(59,109,17,.85);}
.cap-thumb.failed .cap-thumb-label{background:rgba(163,45,45,.85);}
.cap-thumb.unverified .cap-thumb-label{background:rgba(99,56,6,.85);}

/* AI Inspection conditions grid */
/* AI Inspection conditions grid — 5 conditions */
.ai-cond-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.ai-cond-grid .ai-cond:last-child:nth-child(odd){grid-column:1/-1;}
.ai-cond{border:1.5px solid #d0dce8;border-radius:14px;padding:10px 12px;background:#fff;position:relative;transition:all .3s;}
.ai-cond.scanning{border-color:var(--blue);background:var(--lb);}
.ai-cond.detecting{border-color:var(--amber);background:var(--la);animation:detectPulse .8s infinite;}
@keyframes detectPulse{0%,100%{border-color:var(--amber)}50%{border-color:var(--ab)}}
.ai-cond.passed{border-color:var(--green);background:var(--lg);}
.ai-cond.failed{border-color:var(--cd);background:var(--lr);}
.ai-cond.unverified{border-color:var(--amber);background:var(--la);}
.ai-cond-header{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.ai-cond-ico{font-size:20px;color:#94a3b8;flex-shrink:0;}
.ai-cond.scanning .ai-cond-ico{color:var(--blue);}
.ai-cond.detecting .ai-cond-ico{color:var(--amber);}
.ai-cond.passed .ai-cond-ico{color:var(--green);}
.ai-cond.failed .ai-cond-ico{color:var(--cd);}
.ai-cond.unverified .ai-cond-ico{color:var(--amber);}
.ai-cond-name{font-size:11px;font-weight:700;color:#1a2332;line-height:1.3;}
.ai-cond.passed .ai-cond-name{color:var(--green);}
.ai-cond.failed .ai-cond-name{color:var(--red);}
.ai-cond.unverified .ai-cond-name{color:var(--amber);}
.ai-status-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:6px;display:inline-flex;align-items:center;gap:3px;margin-top:3px;}
.badge-scanning{background:var(--lb);color:var(--navy);}
.badge-detecting{background:var(--la);color:var(--amber);}
.badge-passed{background:var(--lg);color:var(--green);}
.badge-failed{background:var(--lr);color:var(--red);}
.badge-unverified{background:var(--la);color:var(--amber);}
.ai-conf-mini{height:4px;border-radius:2px;background:#e0e8f0;overflow:hidden;margin-top:5px;}
.ai-conf-mini-fill{height:100%;border-radius:2px;transition:width .5s;}
.conf-green{background:var(--green);}
.conf-amber{background:#e8a020;}
.conf-red{background:var(--cd);}
.ai-rejection{font-size:9.5px;color:var(--red);margin-top:4px;line-height:1.4;display:none;}
.ai-cond.failed .ai-rejection{display:block;}
.ai-cond.unverified .ai-rejection{display:block;color:var(--amber);}
.ai-ts{font-size:9px;color:#94a3b8;margin-top:3px;font-family:monospace;}
.ai-cond.passed .ai-ts{color:var(--green);}

/* Scan dots animation */
.scan-dots{display:inline-flex;gap:2px;margin-left:4px;}
.scan-dots span{width:3px;height:3px;border-radius:50%;background:var(--blue);display:inline-block;animation:pd 1s infinite;}
.scan-dots span:nth-child(2){animation-delay:.2s}.scan-dots span:nth-child(3){animation-delay:.4s}

/* Compliance summary card */
.compliance-summary{background:#fff;border-radius:16px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);}
.comp-header{font-size:14px;font-weight:700;color:#1a2332;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.comp-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:.5px solid #f0f4f8;}
.comp-row:last-child{border-bottom:none;}
.comp-ico{font-size:18px;flex-shrink:0;}
.comp-name{flex:1;font-size:12px;color:#1a2332;font-weight:500;}
.comp-status{font-size:10px;font-weight:700;padding:3px 9px;border-radius:8px;}
.cs-passed{background:var(--lg);color:var(--green);}
.cs-failed{background:var(--lr);color:var(--red);}
.cs-unverified{background:var(--la);color:var(--amber);}
.comp-reason{font-size:9.5px;color:#7a8a9a;margin-top:2px;}
.comp-flag{font-size:9.5px;font-weight:700;padding:2px 6px;border-radius:6px;background:var(--lr);color:var(--red);}
.comp-thumb{width:44px;height:32px;border-radius:5px;overflow:hidden;flex-shrink:0;}
.comp-thumb canvas,.comp-thumb img{width:100%;height:100%;object-fit:cover;}

/* Master table */
.master-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
.master-table{width:100%;border-collapse:collapse;font-size:11px;min-width:560px;}
.master-table th{text-align:left;padding:8px 10px;font-size:9.5px;font-weight:700;color:#7a8a9a;border-bottom:1px solid #d0dce8;background:#f8fafc;text-transform:uppercase;letter-spacing:.3px;white-space:nowrap;}
.master-table td{padding:8px 10px;border-bottom:1px solid #f0f4f8;color:#5a6a7a;vertical-align:top;}
.master-table td:first-child{font-weight:600;color:#1a2332;}

/* PICE report preview */
.pice-preview{background:#f5f5f5;border-radius:14px;padding:12px;}
.doc-inner{background:#fff;border:.5px solid #ccc;border-radius:4px;padding:18px 22px;box-shadow:0 2px 12px rgba(0,0,0,.1);}
.doc-conf{font-size:10px;font-weight:700;text-align:center;letter-spacing:1px;color:#A32D2D;margin-bottom:7px;}
.doc-title{font-size:11px;font-weight:700;text-align:center;color:#1a1a1a;margin-bottom:11px;line-height:1.4;}
.doc-table{width:100%;border-collapse:collapse;font-size:9.5px;}
.doc-table th{background:#1F4E79;color:#fff;padding:5px 7px;font-weight:600;border:.5px solid #2d6aa0;text-align:center;}
.doc-table th.tl{text-align:left;}
.doc-table td{padding:4px 6px;border:.5px solid #BDD7EE;vertical-align:middle;}
.doc-table td.stn-c{font-weight:700;background:#DEEAF1;font-size:9px;}
.doc-table td.num-c{text-align:center;font-weight:600;color:#1F4E79;}
.doc-table td.ph-c{text-align:center;padding:3px 4px;}
.doc-table tr.tot td{background:#1F4E79;color:#fff;font-weight:700;text-align:center;}
.doc-photo{width:50px;height:36px;object-fit:cover;border-radius:2px;}
.doc-photo-ph{width:50px;height:36px;border:1px dashed #BDD7EE;border-radius:2px;background:#f0f4f8;display:inline-flex;align-items:center;justify-content:center;font-size:7px;color:#94a3b8;}
.doc-motto{font-size:8px;font-style:italic;text-align:center;margin-top:10px;color:#444;}

/* Audit log */
.audit-wrap{background:var(--dn);border-radius:12px;padding:12px;font-size:10px;font-family:monospace;color:var(--mb);max-height:200px;overflow-y:auto;}

#status-bar{padding:4px 13px;background:var(--dn);font-size:9.5px;color:var(--db);display:flex;align-items:center;gap:5px;flex-shrink:0;}
#status-bar strong{color:var(--mb);}
#install-banner{background:linear-gradient(135deg,var(--navy),var(--blue));border-radius:14px;padding:14px 16px;display:none;align-items:center;gap:12px;margin-bottom:4px;}
@media print{#hdr,#user-bar,#bottom-nav,#status-bar{display:none!important;}.pice-preview{background:none;padding:0;}.doc-inner{box-shadow:none;border:none;}}
</style>
</head>
<body>

<div id="splash">
  <div class="sp-logo"><span class="lm">HuGo</span><span class="ls">v8</span></div>
  <div class="sp-title">Human Rights on the Go</div>
  <div class="sp-sub">Bulacan Police Provincial Human Rights Affairs Office · BULPPO, PRO 3</div>
  <div class="sp-dots"><div class="sp-dot"></div><div class="sp-dot"></div><div class="sp-dot"></div></div>
</div>

<div id="app">
  <div id="hdr">
    <div class="hdr-logo"><span class="lm">HuGo</span><span class="ls">v8</span></div>
    <div class="hdr-text"><h1>Human Rights on the Go</h1><div class="hs">BULPPO PRO 3 · <span id="hdr-sub">PHRA Bulacan</span></div></div>
    <div class="live-pill" id="live-pill"><div class="live-dot"></div>LIVE</div>
  </div>
  <div id="offline-bar">⚠ You are offline — AI features unavailable</div>

  <!-- LOGIN -->
  <div id="login-screen">
    <div id="install-banner"><div><div style="font-size:13px;font-weight:600;color:#fff;">Install HuGo</div><div style="font-size:11px;color:var(--mb);margin-top:2px;">Add to home screen</div></div><button style="padding:8px 14px;background:#fff;color:var(--navy);border:none;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;" onclick="installApp()">Install</button><button style="color:var(--mb);font-size:18px;cursor:pointer;background:none;border:none;" onclick="this.parentElement.style.display='none'"><i class="ti ti-x"></i></button></div>
    <div class="ls-title">Welcome to HuGo v10</div>
    <div class="ls-sub">Strict AI visual recognition — Blue PUPC logbook, Yellow PUPC formation, Medicine detection. Select your role to begin.</div>
    <div class="role-grid">
      <div class="role-card" onclick="showStationAuth()"><div class="rc-ico"><i class="ti ti-building"></i></div><div class="rc-name">Station user</div><div class="rc-info">Select your station and enter passcode</div></div>
      <div class="role-card sup-card" onclick="showSuperAuth()"><div class="rc-ico"><i class="ti ti-shield-check"></i></div><div class="rc-name">Super user</div><div class="rc-info">Enter master password for full access</div></div>
    </div>
    <div class="alert info"><i class="ti ti-shield"></i>All data is strictly isolated per station. Access control enforced across all modules.</div>
  </div>

  <!-- STATION AUTH -->
  <div id="station-auth">
    <div class="auth-header"><div class="auth-back" onclick="backToLogin()"><i class="ti ti-arrow-left"></i></div><div style="font-size:16px;font-weight:700;color:#1a2332;">Station login</div></div>
    <div class="auth-card">
      <div class="auth-card-title"><i class="ti ti-building"></i>Select your station</div>
      <div class="fg"><select class="fs" id="stn-select" onchange="onStnSelect()"><option value="">Select station...</option></select></div>
      <div class="fg" id="pass-field" style="display:none;"><div class="fl">Station passcode <span class="req">*</span></div><input type="password" class="tok-inp" id="stn-pass" placeholder="Enter passcode..." oninput="onPassIn()"></div>
      <div class="alert err" id="stn-err" style="display:none;"><i class="ti ti-alert-triangle"></i><span id="stn-err-msg"></span></div>
      <div class="alert info" style="font-size:11px;margin-top:4px;"><i class="ti ti-info-circle"></i>Demo passcode: <strong>PHRA2025</strong></div>
    </div>
    <button class="pbtn" id="stn-btn" onclick="loginStation()" disabled><i class="ti ti-login"></i>Login</button>
    <div class="processing" id="stn-proc"><div class="proc-dots"><div class="proc-dot"></div><div class="proc-dot"></div><div class="proc-dot"></div></div></div>
  </div>

  <!-- SUPER AUTH -->
  <div id="super-auth">
    <div class="auth-header"><div class="auth-back" onclick="backToLogin()"><i class="ti ti-arrow-left"></i></div><div style="font-size:16px;font-weight:700;color:#1a2332;">Super user login</div></div>
    <div class="auth-card">
      <div class="auth-card-title"><i class="ti ti-lock"></i>Master password</div>
      <div class="fg"><input type="password" class="tok-inp" id="su-pass" placeholder="Enter master password..." oninput="onSuIn()"></div>
      <div class="alert err" id="su-err" style="display:none;"><i class="ti ti-alert-triangle"></i>Incorrect password.</div>
      <div class="alert info" style="font-size:11px;margin-top:4px;"><i class="ti ti-info-circle"></i>Demo password: <strong>HUGO@ADMIN2025</strong></div>
    </div>
    <button class="pbtn" id="su-btn" onclick="loginSuper()" disabled><i class="ti ti-shield-check"></i>Login as super user</button>
    <div class="processing" id="su-proc"><div class="proc-dots"><div class="proc-dot"></div><div class="proc-dot"></div><div class="proc-dot"></div></div></div>
  </div>

  <!-- AUTHENTICATED APP -->
  <div id="auth-app" style="display:none;flex:1;flex-direction:column;overflow:hidden;">
    <div id="user-bar">
      <span class="ub-pill" id="ub-pill">Station</span>
      <span id="ub-name" class="ub-name">User</span>
      <span class="flag-ind" id="flag-ind"><i class="ti ti-flag" style="font-size:11px"></i>Flag</span>
      <button class="sw-btn" onclick="logout()">Logout</button>
    </div>
    <div id="content">

      <!-- HOME -->
      <div class="view active" id="view-home">
        <div><div class="greeting" id="home-greeting">Magandang araw!</div><div class="greeting-sub" id="home-sub">Select a module below</div></div>
        <div class="stat-row" id="home-stats"></div>
        <div class="sec-lbl">Reporting modules</div>
        <div class="mod-cards">
          <div class="mod-card" onclick="goNav('pice')"><div class="mc-ico"><i class="ti ti-calendar-week"></i></div><div class="mc-name">Weekly PICE</div><div class="mc-desc">Weekly activity report</div><div class="mc-badge mb-g">Ready</div></div>
          <div class="mod-card" onclick="goNav('med')"><div class="mc-ico"><i class="ti ti-stethoscope"></i></div><div class="mc-name">Monthly Medical</div><div class="mc-desc">Medical check-up report</div><div class="mc-badge mb-g">Ready</div></div>
          <div class="mod-card" onclick="goNav('phros')"><div class="mc-ico"><i class="ti ti-users"></i></div><div class="mc-name">PHROs &amp; COs</div><div class="mc-desc">Excel file submission</div><div class="mc-badge mb-g">Ready</div></div>
          <div class="mod-card" onclick="goNav('idd')"><div class="mc-ico"><i class="ti ti-file-description"></i></div><div class="mc-name">Monthly IDD</div><div class="mc-desc">Disease &amp; death report</div><div class="mc-badge mb-g" id="idd-home-badge">Ready</div></div>
          <div class="mod-card" onclick="goNav('cam')"><div class="mc-ico"><i class="ti ti-camera"></i></div><div class="mc-name">AI Inspection cam</div><div class="mc-desc">Strict image recognition</div><div class="mc-badge mb-b">Token req'd</div></div>
          <div class="mod-card" onclick="goNav('master')"><div class="mc-ico"><i class="ti ti-file-certificate"></i></div><div class="mc-name">Master report</div><div class="mc-desc">Consolidated reports</div><div class="mc-badge mb-b" id="mc-master-badge">Super user only</div></div>
        </div>
        <div class="sec-lbl">Recent activity</div>
        <div class="act-list" id="act-list"><div style="font-size:12px;color:#94a3b8;padding:10px 0;text-align:center;">No activity yet</div></div>
      </div>

      <!-- WEEKLY PICE -->
      <div class="view" id="view-pice">
        <div class="card"><div class="card-title"><i class="ti ti-calendar-week"></i>Weekly PICE</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div class="rw2">
              <div class="fg"><div class="fl">Week <span class="req">*</span></div><select class="fs" id="pice-week" onchange="checkPice()"><option value="">Week...</option><option>Week 1 (Apr 30–May 6)</option><option>Week 2 (May 7–13)</option><option>Week 3 (May 14–20)</option><option>Week 4 (May 21–27)</option></select></div>
              <div class="fg"><div class="fl">Month <span class="req">*</span></div><select class="fs" id="pice-month" onchange="checkPice()"><option value="">Month...</option><option>January</option><option>February</option><option>March</option><option>April</option><option selected>May</option><option>June</option><option>July</option><option>August</option><option>September</option><option>October</option><option>November</option><option>December</option></select></div>
            </div>
            <div class="fg"><div class="fl">Station</div><div id="pice-stn" style="padding:10px 12px;border:1px solid #d0dce8;border-radius:12px;background:#f0f4f8;font-size:13px;font-weight:600;color:#1a2332;"></div></div>
            <div class="fg"><div class="fl">Nr of PICE conducted <span class="req">*</span></div><div class="num-wrap"><button class="num-btn" onclick="adj('pice',-1)">−</button><span class="num-disp" id="pice-d">0</span><button class="num-btn" onclick="adj('pice',1)">+</button><input type="number" class="num-man" id="pice-m" min="0" value="0" oninput="man('pice',this.value)"></div></div>
            <div class="fg"><div class="fl">Nr of participants <span class="req">*</span></div><div class="num-wrap"><button class="num-btn" onclick="adj('part',-1)">−</button><span class="num-disp" id="part-d">0</span><button class="num-btn" onclick="adj('part',1)">+</button><input type="number" class="num-man" id="part-m" min="0" value="0" oninput="man('part',this.value)"></div></div>
            <div class="fg"><div class="fl">Action photo <span class="req">*</span></div>
              <div class="drop-zone" onclick="document.getElementById('pice-fi').click()"><i class="ti ti-photo-up"></i><p>Tap to upload</p><small>JPG, JPEG, PNG · one photo</small></div>
              <div id="pice-prev"></div>
              <input type="file" id="pice-fi" accept="image/jpeg,image/png" style="display:none" onchange="handlePhoto('pice',this.files)">
              <div class="alert err" id="pice-err" style="display:none;margin-top:5px;"><i class="ti ti-alert-triangle"></i><span id="pice-err-msg"></span></div>
            </div>
          </div>
        </div>
        <div class="alert err" id="pice-dup" style="display:none;"><i class="ti ti-alert-triangle"></i>Duplicate — your station already submitted for this week.</div>
        <button class="pbtn" id="pice-btn" onclick="submitMod('pice')" disabled><i class="ti ti-send"></i>Submit Weekly PICE</button>
        <div class="processing" id="pice-proc"><div class="proc-dots"><div class="proc-dot"></div><div class="proc-dot"></div><div class="proc-dot"></div></div></div>
        <div id="pice-success"></div>
      </div>

      <!-- MONTHLY MEDICAL -->
      <div class="view" id="view-med">
        <div class="card"><div class="card-title"><i class="ti ti-stethoscope"></i>Monthly Medical Check-up</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div class="fg"><div class="fl">Station</div><div id="med-stn" style="padding:10px 12px;border:1px solid #d0dce8;border-radius:12px;background:#f0f4f8;font-size:13px;font-weight:600;color:#1a2332;"></div></div>
            <div class="fg"><div class="fl">Reporting month <span class="req">*</span></div><div class="month-grid" id="med-months"></div></div>
            <div class="fg"><div class="fl">Nr of medical check-ups <span class="req">*</span></div><div class="num-wrap"><button class="num-btn" onclick="adj('med',-1)">−</button><span class="num-disp" id="med-d">0</span><button class="num-btn" onclick="adj('med',1)">+</button><input type="number" class="num-man" id="med-m" min="0" value="0" oninput="man('med',this.value)"></div></div>
            <div class="fg"><div class="fl">Action photo <span class="req">*</span></div>
              <div class="drop-zone" onclick="document.getElementById('med-fi').click()"><i class="ti ti-photo-up"></i><p>Tap to upload</p><small>JPG, JPEG, PNG · one photo</small></div>
              <div id="med-prev"></div>
              <input type="file" id="med-fi" accept="image/jpeg,image/png" style="display:none" onchange="handlePhoto('med',this.files)">
            </div>
          </div>
        </div>
        <button class="pbtn" id="med-btn" onclick="submitMod('med')" disabled><i class="ti ti-send"></i>Submit Monthly Medical</button>
        <div class="processing" id="med-proc"><div class="proc-dots"><div class="proc-dot"></div><div class="proc-dot"></div><div class="proc-dot"></div></div></div>
        <div id="med-success"></div>
      </div>

      <!-- PHROs & COs -->
      <div class="view" id="view-phros">
        <div class="card"><div class="card-title"><i class="ti ti-users"></i>Monthly PHROs &amp; COs</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div class="fg"><div class="fl">Station</div><div id="phros-stn" style="padding:10px 12px;border:1px solid #d0dce8;border-radius:12px;background:#f0f4f8;font-size:13px;font-weight:600;color:#1a2332;"></div></div>
            <div class="fg"><div class="fl">Month <span class="req">*</span></div><div class="month-grid" id="phros-months"></div></div>
            <div class="fg"><div class="fl">Upload Excel (.xlsx) <span class="req">*</span></div>
              <div class="drop-zone" onclick="document.getElementById('phros-fi').click()"><i class="ti ti-file-spreadsheet"></i><p>Tap to upload Excel</p><small>.xlsx · Form (A) and Form (B) required</small></div>
              <div id="phros-prev"></div>
              <input type="file" id="phros-fi" accept=".xlsx" style="display:none" onchange="handleXlsx(this.files)">
            </div>
            <div id="phros-val"></div>
          </div>
        </div>
        <button class="pbtn" id="phros-btn" onclick="submitMod('phros')" disabled><i class="ti ti-send"></i>Submit PHROs &amp; COs</button>
        <div class="processing" id="phros-proc"><div class="proc-dots"><div class="proc-dot"></div><div class="proc-dot"></div><div class="proc-dot"></div></div></div>
        <div id="phros-success"></div>
      </div>

      <!-- IDD -->
      <div class="view" id="view-idd">
        <div class="card"><div class="card-title"><i class="ti ti-file-description"></i>Monthly IDD</div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <div class="rw2">
              <div class="fg"><div class="fl">Month <span class="req">*</span></div><select class="fs" id="idd-month" onchange="checkIDD()"><option value="">Month...</option><option>January</option><option>February</option><option>March</option><option>April</option><option>May</option><option>June</option><option>July</option><option>August</option><option>September</option><option>October</option><option>November</option><option>December</option></select></div>
              <div class="fg"><div class="fl">Year <span class="req">*</span></div><select class="fs" id="idd-year" onchange="checkIDD()"><option value="">Year...</option><option>2025</option><option>2026</option><option>2027</option></select></div>
            </div>
