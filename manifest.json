<script>
// ═══════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════
const ALL_STNS=['1ST PMFC','2ND PMFC','ANGAT MPS','BALAGTAS MPS','BALIWAG CPS','BOCAUE MPS','BULAKAN MPS','BUSTOS MPS','CALUMPIT MPS','DRT MPS','GUIGUINTO MPS','HAGONOY MPS','MALOLOS CPS','MARILAO MPS','MEYCAUAYAN CPS','NORZAGARAY MPS','OBANDO MPS','PANDI MPS','PAOMBONG MPS','PLARIDEL MPS','PULILAN MPS','SAN ILDEFONSO MPS','SAN MIGUEL MPS','SAN RAFAEL MPS','SANTA MARIA MPS','SJDM CPS','PHQ'];
const MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
const DISEASES=['Hypertension','Heart Disease','TB','Cough','Colds','Asthma','Flu','Arthritis','Diabetes','UTI','Ulcer','Migraine','HIV','Epilepsy','Skin Disease','Diarrhea'];
const CASE_DESC=['Murder','Homicide','Rape','Robbery','Illegal Drugs (RA 9165)','Illegal Possession of Firearms','Physical Injury','VAWC','Other'];
const VALID_CAM_TOKS=['HUGO-INSPECT-01','PHRA-CAM-2025','BULPPO-SU-99'];
const STATION_PASSCODES={};
ALL_STNS.forEach(s=>STATION_PASSCODES[s]='PHRA2025');
const SUPER_PASSWORD='HUGO@ADMIN2025';

// ═══════════════════════════════════════════
// AI INSPECTION CONDITIONS v8
// Official Visual Inspection Criteria
// 3-tier: GOOD / NEEDS ATTENTION / NOT ACCEPTABLE
// Source: BULPPO Visual Inspection Criteria Chart
// ═══════════════════════════════════════════
// ═══════════════════════════════════════════════════════════
// HuGo AI — OFFICIAL STRICT DETECTION PROMPTS
// 6 conditions · Official labels · Anti-hallucination rules
// ═══════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════
// HuGo AI — HONEST MANUAL INSPECTION TOOL
// No fake AI readings. Inspector physically checks each item
// and taps PASS / FAIL with photo evidence captured.
// ═══════════════════════════════════════════════════════════

const AI_CONDITIONS=[
  {id:1,name:'Fire Extinguisher',icon:'ti-firetruck',label:'fire_extinguisher',
   instruction:'Physically check the fire extinguisher. Tap PASS or FAIL.',
   checklist:['In designated location','Visible and accessible','Pressure gauge in GREEN zone','Inspection tag current and valid','Safety seal intact','Clean and well maintained']},
  {id:2,name:'Medical Kit',icon:'ti-first-aid-kit',label:'medical_kit',
   instruction:'Physically check the medical kit. Open it and inspect contents. Tap PASS or FAIL.',
   checklist:['Kit in designated location','Complete contents as per checklist','All items within expiry date','Clean, sealed and properly organized','Easily accessible']},
  {id:3,name:'Medicines',icon:'ti-pill',label:'medicine',
   instruction:'Check all medicine packaging. Verify labels and expiry dates. Tap PASS or FAIL.',
   checklist:['Pharmaceutical packaging visible','Medicine labels readable','All within expiry date','Properly stored and organized']},
  {id:4,name:'Log Book',icon:'ti-notebook',label:'logbook',
   instruction:'Check the PUPC Logbook. Open and verify entries. Tap PASS or FAIL.',
   checklist:['Blue PUPC Logbook present','Entries complete and accurate','Readable and legible','No missing pages','Properly stored']},
  {id:5,name:'Detainee Formation',icon:'ti-users-group',label:'detainee_formation',
   instruction:'Check detainee formation. Verify yellow uniforms and organized rows. Tap PASS or FAIL.',
   checklist:['Minimum 3 PUPCs in formation','Yellow shirts/uniforms worn','Organized rows facing forward','Hands to the side, at attention','Head count complete and accurate']},
  {id:6,name:'CCTV Camera',icon:'ti-cctv',label:'mounted_cctv',
   instruction:'Check mounted CCTV camera. Verify it is recording. Tap PASS or FAIL.',
   checklist:['Camera in designated location','Unobstructed view','Image clear and functional','Recording working properly','Cables secured and protected']}
];

// ── STATE ──
const STATUS={VERIFIED:'verified',UNVERIFIED:'unverified',FAILED:'failed'};
let conditionResults={};
let capturedImages=[];
let camSid='',camTok='';
let camStream=null;
let aiTimers=[];
let inspectorNotes={};

// ── BUILD INSPECTION CARDS ──
function buildInspectionCards(){
  const el=document.getElementById('ai-conds');
  if(!el) return;
  el.innerHTML='';
  AI_CONDITIONS.forEach(cond=>{
    const card=document.createElement('div');
    card.className='ai-cond scanning';
    card.id='aic-'+cond.id;
    card.innerHTML=buildCondCard(cond,'pending',null);
    el.appendChild(card);
  });
}

function buildCondCard(cond,status,result){
  const icons={pending:'ti-circle',verified:'ti-circle-check',failed:'ti-alert-circle',captured:'ti-camera'};
  const statusColors={
    pending:'#94a3b8',verified:'var(--green)',failed:'var(--cd)',captured:'var(--blue)'
  };
  const checklist=cond.checklist.map(item=>{
    const checked=result?.checkedItems?.[item];
    return `<div style="display:flex;align-items:center;gap:6px;padding:3px 0;font-size:10.5px;color:${checked===true?'var(--green)':checked===false?'var(--cd)':'#5a6a7a'};">
      <i class="ti ${checked===true?'ti-circle-check':checked===false?'ti-circle-x':'ti-circle'}" style="font-size:13px;flex-shrink:0;color:${checked===true?'var(--green)':checked===false?'var(--cd)':'#c0cdd8'};"></i>
      ${item}
    </div>`;
  }).join('');

  const hasPhoto=result?.dataURL;
  const photoHTML=hasPhoto?`<img src="${result.dataURL}" style="width:100%;height:80px;object-fit:cover;border-radius:8px;margin-bottom:8px;">`:
    `<div style="height:60px;border-radius:8px;background:#f0f4f8;display:flex;align-items:center;justify-content:center;margin-bottom:8px;border:2px dashed #d0dce8;"><i class="ti ti-camera" style="font-size:20px;color:#c0cdd8;"></i></div>`;

  const noteVal=inspectorNotes[cond.id]||'';
  const st=result?.status;

  return `
    <div class="ai-cond-header">
      <i class="ti ${cond.icon} ai-cond-ico" style="color:${st===STATUS.VERIFIED?'var(--green)':st===STATUS.FAILED?'var(--cd)':'#94a3b8'};"></i>
      <div style="flex:1;">
        <div class="ai-cond-name">${cond.name}</div>
        <div style="font-size:9px;color:#94a3b8;font-family:monospace;">${cond.label}</div>
      </div>
      ${st===STATUS.VERIFIED?'<span style="padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;background:var(--lg);color:var(--green);">✓ PASSED</span>':
        st===STATUS.FAILED?'<span style="padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;background:var(--lr);color:var(--red);">✗ FAILED</span>':''}
    </div>
    <div style="font-size:10px;color:#5a6a7a;margin:6px 0;padding:6px 8px;background:#f8fafc;border-radius:8px;line-height:1.5;">${cond.instruction}</div>
    ${photoHTML}
    <div style="font-size:10.5px;font-weight:600;color:#5a6a7a;margin-bottom:4px;">Checklist:</div>
    <div style="margin-bottom:8px;">${checklist}</div>
    <div style="margin-bottom:8px;">
      <textarea id="note-${cond.id}" placeholder="Inspector notes (optional)..." 
        style="width:100%;padding:7px 9px;font-size:11px;font-family:inherit;border:1px solid #d0dce8;border-radius:10px;outline:none;resize:none;height:52px;background:#f8fafc;color:#1a2332;"
        oninput="inspectorNotes[${cond.id}]=this.value">${noteVal}</textarea>
    </div>
    <div style="display:flex;gap:6px;margin-bottom:6px;">
      <button onclick="captureAndMark(${cond.id},'pass')" 
        style="flex:1;padding:10px;background:var(--green);color:#fff;border:none;border-radius:11px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-family:inherit;">
        <i class="ti ti-camera"></i> Capture &amp; PASS
      </button>
      <button onclick="captureAndMark(${cond.id},'fail')" 
        style="flex:1;padding:10px;background:var(--crim);color:#fff;border:none;border-radius:11px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-family:inherit;">
        <i class="ti ti-camera"></i> Capture &amp; FAIL
      </button>
    </div>
    <div style="display:flex;gap:6px;">
      <button onclick="markCondition(${cond.id},'pass')" 
        style="flex:1;padding:8px;background:#f8fafc;border:1.5px solid var(--green);color:var(--green);border-radius:10px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">
        ✓ PASS (no photo)
      </button>
      <button onclick="markCondition(${cond.id},'fail')" 
        style="flex:1;padding:8px;background:#f8fafc;border:1.5px solid var(--cd);color:var(--cd);border-radius:10px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">
        ✗ FAIL (no photo)
      </button>
      <button onclick="resetCondition(${cond.id})" 
        style="padding:8px 10px;background:#f8fafc;border:1px solid #d0dce8;color:#7a8a9a;border-radius:10px;font-size:11px;cursor:pointer;font-family:inherit;">
        Reset
      </button>
    </div>`;
}

// ── CAPTURE PHOTO AND MARK ──
function captureAndMark(condId, result){
  const cond=AI_CONDITIONS.find(c=>c.id===condId);
  const vid=document.getElementById('cam-video');
  const cv=document.createElement('canvas');
  cv.width=vid.videoWidth||320; cv.height=vid.videoHeight||240;
  const ctx=cv.getContext('2d');
  try{ctx.drawImage(vid,0,0,cv.width,cv.height);}catch(e){}
  // Overlay
  ctx.fillStyle='rgba(4,44,83,0.85)';ctx.fillRect(0,cv.height-28,cv.width,28);
  ctx.fillStyle='#fff';ctx.font='bold 11px monospace';
  const statusTxt=result==='pass'?'✓ PASSED':'✗ FAILED';
  ctx.fillText('['+condId+'] '+cond.name+' — '+statusTxt+' · '+new Date().toISOString().substring(0,19),5,cv.height-10);
  const flash=document.getElementById('cap-flash');
  if(flash){flash.classList.add('snap');setTimeout(()=>flash.classList.remove('snap'),200);}
  const dataURL=cv.toDataURL('image/jpeg',0.90);
  markCondition(condId, result, dataURL);
}

// ── MARK CONDITION ──
function markCondition(condId, result, dataURL){
  const cond=AI_CONDITIONS.find(c=>c.id===condId);
  const status=result==='pass'?STATUS.VERIFIED:STATUS.FAILED;
  const note=inspectorNotes[condId]||document.getElementById('note-'+condId)?.value||'';
  inspectorNotes[condId]=note;

  // Build checked items — all checked if PASS, none if FAIL
  const checkedItems={};
  cond.checklist.forEach(item=>{checkedItems[item]=result==='pass';});

  const ts=new Date().toISOString();
  conditionResults[condId]={
    conditionId:condId, name:cond.name, label:cond.label,
    status, dataURL:dataURL||null,
    inspectorNote:note,
    checkedItems, timestamp:ts,
    inspectedBy:userId,
    json:{
      inspection_type:cond.name, label:cond.label,
      object_detected:true,
      context_verified:result==='pass',
      condition_verified:result==='pass',
      environment_verified:result==='pass',
      temporal_stability_verified:true,
      confidence_score:result==='pass'?100:0,
      threshold_required:100,
      stable_frames:'manual',
      anti_hallucination_passed:true,
      final_status:status.toUpperCase(),
      failure_reasons:result==='fail'?[note||'Failed — inspector marked as non-compliant']:[],
      verification_summary:result==='pass'?
        cond.name+' physically verified by inspector'+( note?' — Notes: '+note:''):
        cond.name+' FAILED — inspector marked non-compliant'+(note?' — Notes: '+note:'')
    }
  };

  if(dataURL){
    capturedImages.push({conditionId:condId,name:cond.name,status,
      dataURL,timestamp:ts});
    addThumbnail(condId,status,dataURL);
    document.getElementById('cap-count').textContent=capturedImages.length;
  }

  // Rebuild card
  const card=document.getElementById('aic-'+condId);
  if(card){
    card.className='ai-cond '+(status===STATUS.VERIFIED?'passed':'failed');
    card.innerHTML=buildCondCard(cond,status,conditionResults[condId]);
  }

  // Update progress
  updateInspectionProgress();

  // Flag if failed
  if(status===STATUS.FAILED){
    const fi=document.getElementById('flag-ind');
    if(fi){fi.style.display='flex';fi.innerHTML='<i class="ti ti-flag" style="font-size:11px"></i>'+cond.name+' FAILED';}
    addDetLog('FAILED','['+condId+'] ✗ '+cond.name+' marked FAILED by inspector'+(note?' — '+note:''),'err');
  } else {
    addDetLog('PASSED','['+condId+'] ✓ '+cond.name+' marked PASSED by inspector'+(note?' — '+note:''),'ok');
  }
}

// ── RESET CONDITION ──
function resetCondition(condId){
  delete conditionResults[condId];
  const cond=AI_CONDITIONS.find(c=>c.id===condId);
  const card=document.getElementById('aic-'+condId);
  if(card){card.className='ai-cond scanning';card.innerHTML=buildCondCard(cond,'pending',null);}
  updateInspectionProgress();
  addDetLog('RESET','['+condId+'] '+cond.name+' reset by inspector','info');
}

// ── PROGRESS BAR ──
function updateInspectionProgress(){
  const done=Object.keys(conditionResults).length;
  const total=AI_CONDITIONS.length;
  const passed=Object.values(conditionResults).filter(r=>r.status===STATUS.VERIFIED).length;
  const failed=Object.values(conditionResults).filter(r=>r.status===STATUS.FAILED).length;
  const pct=Math.round(done/total*100);

  const bar=document.getElementById('insp-progress-bar');
  const txt=document.getElementById('insp-progress-txt');
  if(bar) bar.style.width=pct+'%';
  if(txt) txt.textContent=done+'/'+total+' conditions checked · '+passed+' passed · '+failed+' failed';

  // Show generate report button when all done
  const genBtn=document.getElementById('insp-gen-btn');
  if(genBtn) genBtn.style.display=done===total?'flex':'none';

  setAIStatus(done+'/'+total+' conditions inspected',pct);
}

// ── ADD THUMBNAIL ──
function addThumbnail(condId,status,dataURL){
  const strip=document.getElementById('cap-strip');
  const thumb=document.createElement('div');
  thumb.className='cap-thumb '+(status===STATUS.VERIFIED?'passed':'failed');
  const cv=document.createElement('canvas');cv.width=64;cv.height=48;
  const ctx=cv.getContext('2d');
  const img=new Image();img.onload=()=>ctx.drawImage(img,0,0,64,48);img.src=dataURL;
  thumb.appendChild(cv);
  const lbl=document.createElement('div');lbl.className='cap-thumb-label';
  lbl.textContent=status===STATUS.VERIFIED?'✓ PASSED':'✗ FAILED';
  thumb.appendChild(lbl);strip.appendChild(thumb);strip.scrollLeft=strip.scrollWidth;
}

// ── START INSPECTION (replaces startAIDetection) ──
function startAIDetection(){
  setAIStatus('Manual inspection mode — tap PASS or FAIL per condition',0);
  buildInspectionCards();
  updateInspectionProgress();
  addDetLog('START','[SYS] Manual inspection started — '+AI_CONDITIONS.length+' conditions to inspect','info');
  addDetLog('INFO','[SYS] Point camera at each item, capture photo, then tap PASS or FAIL','info');
}

// ── GENERATE REPORT ──
function generateInspectionReport(){
  const verified=AI_CONDITIONS.filter(c=>conditionResults[c.id]?.status===STATUS.VERIFIED);
  const failed=AI_CONDITIONS.filter(c=>conditionResults[c.id]?.status===STATUS.FAILED);
  const notChecked=AI_CONDITIONS.filter(c=>!conditionResults[c.id]);
  const flagCount=failed.length+notChecked.length;

  const ds=document.getElementById('cam-done-sec');
  ds.style.display='flex';ds.style.flexDirection='column';
  document.getElementById('cam-live-sec').style.display='none';
  document.getElementById('live-pill').style.display='none';
  if(camStream){camStream.getTracks().forEach(t=>t.stop());camStream=null;}

  // Compliance rows
  const cr=document.getElementById('comp-rows');cr.innerHTML='';
  AI_CONDITIONS.forEach(cond=>{
    const result=conditionResults[cond.id];
    const st=result?.status;
    const sc={
      [STATUS.VERIFIED]:{label:'✓ PASSED',cls:'cs-passed',color:'var(--green)',flag:false},
      [STATUS.FAILED]:{label:'✗ FAILED',cls:'cs-failed',color:'var(--cd)',flag:true}
    }[st]||{label:'— Not checked',cls:'cs-unverified',color:'#94a3b8',flag:true};

    const row=document.createElement('div');row.className='comp-row';
    let thumb='<div class="comp-thumb" style="background:#e0e8f0;display:flex;align-items:center;justify-content:center;"><i class="ti ti-camera" style="font-size:14px;color:#94a3b8;"></i></div>';
    if(result?.dataURL) thumb='<div class="comp-thumb"><img src="'+result.dataURL+'" alt="'+cond.name+'"></div>';
    row.innerHTML=
      '<i class="ti '+cond.icon+' comp-ico" style="color:'+sc.color+';"></i>'+
      '<div style="flex:1;">'+
        '<div class="comp-name">'+cond.name+'</div>'+
        '<div class="comp-reason" style="color:#94a3b8;font-size:9px;font-family:monospace;">'+cond.label+'</div>'+
        (result?.inspectorNote?'<div class="comp-reason" style="color:#5a6a7a;">📝 '+result.inspectorNote+'</div>':'')+
        (result?.timestamp?'<div class="comp-reason">Inspected: '+result.timestamp.substring(0,19).replace('T',' ')+'</div>':'')+
      '</div>'+
      (sc.flag?'<span class="comp-flag">FLAGGED</span>':'')+
      '<span class="comp-status '+sc.cls+'">'+sc.label+'</span>'+thumb;
    cr.appendChild(row);
  });

  // Flagged section
  const fs=document.getElementById('flagged-section');
  if(flagCount>0){
    fs.style.display='block';
    document.getElementById('flagged-msg').textContent=
      flagCount+' item'+(flagCount>1?'s':'')+' require action — '+
      failed.length+' FAILED, '+notChecked.length+' not checked. Super user notified.';
  }

  // JSON
  const overall=failed.length>0?'FAILED — IMMEDIATE ACTION REQUIRED':
    notChecked.length>0?'INCOMPLETE — NOT ALL CONDITIONS CHECKED':
    'PASSED — FULLY COMPLIANT';

  const sessionJSON={
    inspection_session_id:camSid, token:camTok,
    inspector_id:userId, station:myStation||'N/A',
    inspection_type:'MANUAL — Physical inspection with photo evidence',
    timestamp_end:new Date().toISOString(),
    compliance_summary:{
      total:AI_CONDITIONS.length,
      passed:verified.length,
      failed:failed.length,
      not_checked:notChecked.length,
      overall_status:overall,
      photos_captured:capturedImages.length
    },
    condition_results:AI_CONDITIONS.map(c=>{
      const r=conditionResults[c.id];
      return r?.json||{inspection_type:c.name,label:c.label,
        final_status:'NOT_CHECKED',failure_reasons:['Not inspected']};
    })
  };

  document.getElementById('cam-json').textContent=JSON.stringify(sessionJSON,null,2);
  addActivity('cam',flagCount>0,
    'Inspection '+camSid+' · '+verified.length+'/'+AI_CONDITIONS.length+' PASSED'+(flagCount>0?' [FLAGGED]':''),'cam');
  buildHomeStats();
  saveInspectionResult(sessionJSON);
}

// ── HELPER FUNCTIONS ──
function setAIStatus(msg,conf){
  const txt=document.getElementById('ai-status-txt');if(txt) txt.textContent=msg;
  const fill=document.getElementById('ai-conf-fill');if(fill) fill.style.width=(conf||0)+'%';
}

function addDetLog(level,msg,type){
  const log=document.getElementById('det-log');if(!log) return;
  if(log.querySelector('[style*="color:#94a3b8"]')) log.innerHTML='';
  const ts=new Date().toISOString().substring(11,19);
  const colors={ok:'var(--green)',err:'var(--cd)',warn:'var(--amber)',info:'var(--blue)'};
  const icons={ok:'ti-check-circle',err:'ti-alert-circle',warn:'ti-alert-triangle',info:'ti-info-circle'};
  const row=document.createElement('div');
  row.style.cssText='display:flex;align-items:flex-start;gap:6px;padding:5px 0;border-bottom:.5px solid #f0f4f8;font-size:10.5px;';
  row.innerHTML=`<i class="ti ${icons[type]||'ti-circle'}" style="font-size:14px;color:${colors[type]||'#94a3b8'};flex-shrink:0;margin-top:1px;"></i>
    <div style="flex:1;color:#1a2332;font-family:monospace;">${msg}</div>
    <span style="font-size:9px;color:#94a3b8;font-family:monospace;white-space:nowrap;">${ts}</span>`;
  log.insertBefore(row,log.firstChild);
}

function triggerInspectionFlag(condName,reason){
  const fi=document.getElementById('flag-ind');if(!fi) return;
  fi.style.display='flex';fi.innerHTML='<i class="ti ti-flag" style="font-size:11px"></i>'+condName+' FAILED';
}

function manualCapture(){
  const vid=document.getElementById('cam-video');
  const cv=document.createElement('canvas');cv.width=vid.videoWidth||320;cv.height=vid.videoHeight||240;
  const ctx=cv.getContext('2d');try{ctx.drawImage(vid,0,0,cv.width,cv.height);}catch(e){}
  ctx.fillStyle='rgba(4,44,83,0.85)';ctx.fillRect(0,cv.height-26,cv.width,26);
  ctx.fillStyle='#fff';ctx.font='10px monospace';
  ctx.fillText('MANUAL · '+new Date().toISOString().substring(11,19),5,cv.height-9);
  const flash=document.getElementById('cap-flash');
  if(flash){flash.classList.add('snap');setTimeout(()=>flash.classList.remove('snap'),150);}
  const url=cv.toDataURL('image/jpeg',0.90);
  capturedImages.push({conditionId:0,name:'Manual',status:'verified',dataURL:url,timestamp:new Date().toISOString()});
  const strip=document.getElementById('cap-strip');
  const thumb=document.createElement('div');thumb.className='cap-thumb passed';
  const c2=document.createElement('canvas');c2.width=64;c2.height=48;
  const ctx2=c2.getContext('2d');const img2=new Image();img2.onload=()=>ctx2.drawImage(img2,0,0,64,48);img2.src=url;
  thumb.appendChild(c2);const lbl=document.createElement('div');lbl.className='cap-thumb-label';lbl.textContent='PHOTO';
  thumb.appendChild(lbl);strip.appendChild(thumb);strip.scrollLeft=strip.scrollWidth;
  document.getElementById('cap-count').textContent=capturedImages.length;
  addDetLog('PHOTO','[CAM] Manual photo captured','info');
}

function stopCam(){
  generateInspectionReport();
}

function copyCamJSON(){
  navigator.clipboard.writeText(document.getElementById('cam-json').textContent)
    .then(()=>{const b=document.querySelector('#cam-done-sec .copy-btn');
    if(b){b.textContent='Copied!';setTimeout(()=>{b.innerHTML='<i class="ti ti-copy"></i>Copy JSON';},2000);}});
}

function saveInspectionResult(json){
  if(typeof submitToSupabase==='function') submitToSupabase('inspection',json);
}

function resetCam(){
  conditionResults={};capturedImages=[];inspectorNotes={};aiTimers=[];
  document.getElementById('cam-done-sec').style.display='none';
  document.getElementById('cam-tok-sec').style.display='block';
  document.getElementById('cam-tok').value='';
  document.getElementById('cam-val-btn').disabled=true;
  document.getElementById('cam-tok-err').style.display='none';
  document.getElementById('cam-validating').style.display='none';
  document.getElementById('cap-strip').innerHTML='';
  document.getElementById('cap-count').textContent='0';
  document.getElementById('flagged-section').style.display='none';
  camSid='';camTok='';
}

// ═══════════════════════════════════════════
// MASTER REPORT
// ═══════════════════════════════════════════
function buildMasterView(){
  const granted=checkAccess(role==='super'?'ALL_STATIONS':myStation,'view-master','MASTER_REPORT');
  if(!granted){document.getElementById('master-denied').style.display='flex';document.getElementById('master-su').style.display='none';return;}
  document.getElementById('master-denied').style.display='none';
  const ms=document.getElementById('master-su');ms.style.display='flex';ms.style.flexDirection='column';
  updatePhrosNotif();updateIddNotif();buildMaster();updateAuditDisplay();
}

function buildMaster(){
  const all=records;const flags=all.filter(r=>r.flag).length;
  const totalPice=all.filter(r=>r.mod==='pice').reduce((a,r)=>a+(r.payload?.pice_count||0),0);
  const totalPart=all.filter(r=>r.mod==='pice').reduce((a,r)=>a+(r.payload?.participants||0),0);
  document.getElementById('master-stats').innerHTML=`
    <div class="stat-card"><div class="sv s">${all.length}</div><div class="sl2">Total submissions</div></div>
    <div class="stat-card"><div class="sv d">${flags}</div><div class="sl2">Priority flags</div></div>
    <div class="stat-card"><div class="sv">${totalPice}</div><div class="sl2">Total PICE</div></div>
    <div class="stat-card"><div class="sv">${totalPart}</div><div class="sl2">Total participants</div></div>`;
  const tbody=document.getElementById('master-tbody');tbody.innerHTML='';
  document.getElementById('master-empty').style.display=all.length?'none':'block';
  all.forEach(r=>{const p=r.payload||{};const tr=document.createElement('tr');tr.innerHTML=`<td><span class="stn-pill sp-b">${r.station}</span></td><td>${p.pice_count||'—'}</td><td>${p.participants||'—'}</td><td>${p.count||'—'}</td><td style="font-size:9.5px;max-width:70px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${p.file||'—'}</td><td><span class="stn-pill ${p.form1==='NEGATIVE'?'sp-g':'sp-r'}">${p.form1||'—'}</span></td><td><span class="stn-pill ${p.form2==='NEGATIVE'?'sp-g':'sp-r'}">${p.form2||'—'}</span></td><td>${r.flag?'<span class="stn-pill sp-r">FLAG</span>':'<span class="stn-pill sp-g">Clear</span>'}</td>`;tbody.appendChild(tr);});
}

function flagMissing(){const piceSubmitted=new Set(records.filter(r=>r.mod==='pice').map(r=>r.station));const missing=ALL_STNS.filter(s=>!piceSubmitted.has(s));if(!missing.length){alert('All stations have submitted.');return;}alert('Missing stations ('+missing.length+'):\n\n'+missing.join('\n'));}

async function generateMaster(){
  const piceRecs=records.filter(r=>r.mod==='pice');if(!piceRecs.length){alert('No Weekly PICE submissions yet.');return;}
  document.getElementById('gen-btn').disabled=true;document.getElementById('gen-proc').style.display='block';
  await new Promise(r=>setTimeout(r,2000));document.getElementById('gen-proc').style.display='none';
  const fm=document.getElementById('f-month')?.value||'May';
  const totalPice=piceRecs.reduce((a,r)=>a+(r.payload?.pice_count||0),0);
  const totalPart=piceRecs.reduce((a,r)=>a+(r.payload?.participants||0),0);
  const allRows=ALL_STNS.map(stn=>{const sub=piceRecs.find(r=>r.station===stn);return{station:stn,pice:sub?sub.payload.pice_count:'—',participants:sub?sub.payload.participants:'—',photo:sub?sub.payload.photoURL:null};});
  const tableRows=allRows.map(r=>`<tr><td class="stn-c"><strong>${r.station}</strong></td><td class="ph-c">${r.photo?`<img class="doc-photo" src="${r.photo}" alt="Photo">`:`<div class="doc-photo-ph">No photo</div>`}</td><td class="num-c">${r.pice}</td><td class="num-c">${r.participants}</td></tr>`).join('');
  const week=piceRecs[0]?.week||'Week 1';
  document.getElementById('doc-preview').innerHTML=`
    <div class="doc-conf">CONFIDENTIAL</div>
    <div class="doc-title">Bulacan PPO: <u>Human Rights</u> Reminders for the Month of <u>${fm}</u> 2026</div>
    <table class="doc-table"><thead><tr><th colspan="4" class="tl" style="font-size:8.5px;font-weight:400;background:#2E75B6;padding:5px 7px;">Attached were the consolidated action taken of different respective Police Human Rights Officers of municipal/city police stations and PMFCs of this PPO pertaining to the dissemination of Human Rights Reminders during the conduct of DPPA/PICE — ${week}.</th></tr><tr><th class="tl" style="width:28%;">Station / Units</th><th style="width:36%;">Action Photo</th><th style="width:18%;">Nr of PICE Conducted</th><th style="width:18%;">No. of Participants</th></tr></thead><tbody>${tableRows}<tr class="tot"><td colspan="2" style="text-align:right;padding-right:10px;font-size:9px;"><strong>Total Nr of PICE Conducted and Nr of Participants:</strong></td><td><strong>${totalPice}</strong></td><td><strong>${totalPart}</strong></td></tr></tbody></table>
    <div class="doc-motto"><em>"Bagong PNP para sa Bagong Pilipinas; Serbisyong Mabilis, Tapat, at Nararamdaman"</em></div>
    <div class="doc-conf" style="margin-top:8px;">CONFIDENTIAL</div>`;
  const go=document.getElementById('gen-out');go.style.display='flex';go.style.flexDirection='column';
  document.getElementById('gen-btn').disabled=false;
  checkAccess('ALL_STATIONS','generate-master','MASTER_REPORT');
}

function exportMaster(){navigator.clipboard.writeText(document.getElementById('cam-json')?.textContent||'{}').then(()=>alert('Report data copied. Paste into your master Word/Excel template.'));}
</script>
